# ════════════════════════════════════════════════════════════════════
# PharmaPro - Environment Configuration Template
# Copy to .env and adjust values before running.
# ════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1
APP_URL=http://localhost:4200

# ── Database (PostgreSQL 16) ─────────────────────────────────────────
DATABASE_URL=postgresql://pharmapro:pharmapro123@localhost:5433/pharmapro?schema=public

# ── Redis 7 ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# ── Auth / JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Security ─────────────────────────────────────────────────────────
# Argon2id tuning
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# CORS
CORS_ORIGIN=http://localhost:4200

# ── Optional: Mail ───────────────────────────────────────────────────
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_FROM=no-reply@pharmapro.local

# ── File uploads ─────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10