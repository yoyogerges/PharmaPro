{
  "name": "pharmapro",
  "version": "1.0.0",
  "private": true,
  "description": "PharmaPro - Professional Pharmacy Management System",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run start:dev --workspace @pharmapro/api",
    "dev:web": "npm run start --workspace @pharmapro/web",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "build:api": "npm run build --workspace @pharmapro/api",
    "build:web": "npm run build --workspace @pharmapro/web",
    "test": "npm run test --workspace @pharmapro/api",
    "test:e2e": "npm run test:e2e --workspace @pharmapro/api",
    "lint": "npm run lint --workspace @pharmapro/api && npm run lint --workspace @pharmapro/web",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down && docker compose up -d && prisma migrate reset --force && prisma db seed",
    "setup": "npm install && docker compose up -d && npm run prisma:generate && npm run prisma:migrate && npm run prisma:seed",
    "setup:shell": "node scripts/setup.js",
    "build:shared": "npm run build --workspace @pharmapro/shared"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.12.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
